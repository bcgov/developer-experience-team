{
  "testEnvironment": "node",
  "transform": {
    "^.+\\.tsx?$": "babel-jest"
  },
  "transformIgnorePatterns": [
    "node_modules/(?!(react-native|@react-native)/)"
  ],
  "testPathIgnorePatterns": [
    "/node_modules/",
    "/android/",
    "/ios/"
  ],
  "setupFilesAfterEnv": ["<rootDir>/jest.setup.js"],
  "moduleFileExtensions": ["ts", "tsx", "js", "jsx", "json", "node"]
}
